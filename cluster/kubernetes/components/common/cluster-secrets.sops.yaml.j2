---
# Secret values available to every app via ${SECRET_*} substitution.
# Source: cluster.secrets.sops.yaml (edit with `just secrets`); applied once at bootstrap.
apiVersion: v1
kind: Secret
metadata:
  name: cluster-secrets
  namespace: flux-system
  labels:
    kustomize.toolkit.fluxcd.io/prune: disabled
stringData:
  SECRET_DOMAIN: "#{ secrets.domain }#"
  SECRET_INTERNAL_DOMAIN: "#{ secrets.internal_domain }#"
