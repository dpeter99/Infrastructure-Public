---
creation_rules:
  # Root secret values file: every value encrypted, keys stay visible.
  - path_regex: cluster\.secrets\.sops\.ya?ml$
    mac_only_encrypted: true
    age: "#{ age_key('public') }#"
  - path_regex: talos/.*\.sops\.ya?ml
    mac_only_encrypted: true
    age: "#{ age_key('public') }#"
  - path_regex: (bootstrap|kubernetes)/.*\.sops\.ya?ml
    encrypted_regex: "^(data|stringData)$"
    mac_only_encrypted: true
    age: "#{ age_key('public') }#"
stores:
  yaml:
    indent: 2